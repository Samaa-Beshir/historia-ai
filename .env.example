# Copy to .env and fill in. Never commit the real .env.

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Optional: set to require an X-API-Key header on all /api/* routes.
API_KEY=
RATE_LIMIT_PER_MINUTE=60

# LLM provider: gemini | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# Note: free-tier keys often have zero quota for gemini-2.0-flash. Check with
# GET https://generativelanguage.googleapis.com/v1beta/models before choosing.
GEMINI_MODEL=gemini-3.6-flash

# Gemini 3.x are thinking models: reasoning tokens are drawn from the same
# budget as the reply, so the 1024 default truncates answers mid-sentence.
LLM_MAX_OUTPUT_TOKENS=4096

# Only needed if LLM_PROVIDER is switched to one of these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

RETRIEVAL_TOP_K=5

# Embeddings: keep these three values paired with the matching Chroma index.
# Multilingual V2 candidate (ONNX Runtime; no PyTorch required):
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_THREADS=2

# Low-memory hosted alternative for small deployment instances:
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL_NAME=gemini-embedding-001
# EMBEDDING_OUTPUT_DIMENSIONALITY=768
# EMBEDDING_DOCUMENT_TASK_TYPE=RETRIEVAL_DOCUMENT
# EMBEDDING_QUERY_TASK_TYPE=QUESTION_ANSWERING
# EMBEDDING_REQUEST_TIMEOUT_SECONDS=60
# EMBEDDING_MAX_RETRIES=3
